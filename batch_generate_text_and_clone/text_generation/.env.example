# Copy to .env and adjust for your vLLM deployment.
# Default: Qwen3.6-27B on local vLLM (OpenAI-compatible API)

LLM_MODEL=qwen3.6-27b
LLM_API_KEY=EMPTY
LLM_BASE_URL=http://localhost:8000/v1

# Multi-instance vLLM (optional): round-robin across ports 8000-8003
# LLM_BASE_URLS=http://localhost:8000/v1,http://localhost:8001/v1,http://localhost:8002/v1,http://localhost:8003/v1

# Override at runtime
# GEN_TOTAL_TARGET=500
# GEN_BATCH_SIZE=10
# GEN_MAX_WORKERS=10
